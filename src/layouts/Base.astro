---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import Header from '@/components/Header.astro';
import { SITE, type Lang } from '@/data/site';
import { OG_LOCALE, otherLang, useT } from '@/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page, with leading and trailing slash. */
  path: string;
  /** Path of the same page in the other language. */
  altPath: string;
  topic: string;
  home?: boolean;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Social preview for this page (site-relative src); defaults to the site's card. */
  ogImage?: { src: string; alt: string; width: number; height: number };
}

const {
  lang,
  title,
  description,
  path,
  altPath,
  topic,
  home = false,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  ogImage: pageOg,
} = Astro.props;

const t = useT(lang);
const other = otherLang(lang);
const abs = (p: string) => new URL(p, SITE.url).href;
const canonical = abs(path);
const paths: Record<Lang, string> = lang === 'en' ? { en: path, es: altPath } : { en: altPath, es: path };
const og = pageOg
  ? { ...pageOg, src: abs(pageOg.src) }
  : { src: abs(`/og-${lang}.png`), alt: t.meta.ogAlt, width: 1200, height: 630 };
---

<!doctype html>
<html lang={lang} data-theme="light" data-tone="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {}
        var dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        d.dataset.theme = dark ? 'dark' : 'light';
        d.classList.add('js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={abs(paths.en)} />
          <link rel="alternate" hreflang="es" href={abs(paths.es)} />
          <link rel="alternate" hreflang="x-default" href={abs(paths.en)} />
        </>
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og.src} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.src} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f4efe3" data-theme-color />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-hand" />
    <Font cssVariable="--font-mono" />

    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <Header lang={lang} t={t} topic={topic} altPath={altPath} home={home} />
    <main id="main">
      <slot />
    </main>
    <script>
      import '@/scripts/app.ts';
    </script>
  </body>
</html>
