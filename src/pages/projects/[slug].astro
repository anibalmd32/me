---
import CaseStudyPage from '@/components/CaseStudyPage.astro';
import { getProjects, projectSlug, type Project } from '@/lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects('en');
  return projects.map((project) => ({ params: { slug: projectSlug(project) }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<CaseStudyPage lang="en" project={project} />
