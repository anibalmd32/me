---
import { sketchArrow } from '@/lib/sketch';
import type { Dictionary } from '@/i18n';

interface Props {
  stop: Dictionary['experience']['stops'][number];
  role: string;
  remote: string;
  next?: string;
}

const { stop, role, remote, next } = Astro.props;
const arrow = sketchArrow([4, 24], [96, 18], 'next-page', -0.18, 16);
---

<article class="page">
  <p class="page__period hand">{stop.period}</p>
  <div class="page__body">
    <div class="page__head">
      <h3 class="page__company display">{stop.company}</h3>
      <p class="page__role">
        {role} <span aria-hidden="true">/</span> {remote}
      </p>
      <p class="page__year display" aria-hidden="true">{stop.year}</p>
    </div>
    <div class="page__detail">
      <ul class="page__list dash-list">
        {stop.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
      {
        next && (
          <p class="page__next">
            <span class="hand">{next}</span>
            <svg viewBox="0 0 104 40" width="104" height="40" aria-hidden="true">
              <path class="ink" d={arrow.shaft} />
              <path class="ink" d={arrow.head} />
            </svg>
          </p>
        )
      }
    </div>
  </div>
</article>

<style>
  .page {
    position: relative;
    display: grid;
    gap: 0.75rem;
  }

  .page__period {
    justify-self: start;
  }

  .page__year {
    display: none;
  }

  .page__body {
    display: grid;
    gap: 1rem clamp(1.5rem, 5vw, 5rem);
  }

  .page__company {
    font-size: clamp(2.2rem, min(6vw, 11svh), 5rem);
  }

  .page__role {
    margin-top: 0.6rem;
    color: var(--fg-soft);
    font-weight: 500;
  }

  .page__list {
    display: grid;
    gap: 0.65rem;
    max-width: 58ch;
  }

  .page__list li {
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.45;
  }

  .page__next {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--blue);
  }

  .page__next svg {
    flex: none;
  }

  :global(html.motion) .page {
    position: absolute;
    inset: 0;
    align-content: start;
    gap: clamp(1rem, 4.5svh, 3rem);
    padding: clamp(1.25rem, 6svh, 4rem) calc(var(--edge) - var(--desk)) 1.5rem;
  }

  :global(html.motion) .page__head {
    container-type: inline-size;
  }

  :global(html.motion) .page__year {
    display: block;
    margin-top: clamp(0.9rem, 4svh, 2.5rem);
    font-size: clamp(3.25rem, min(38cqi, 30svh), 16rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--blue-wash);
  }

  :global(html.motion) .page__list li {
    font-size: clamp(1rem, 1.5vw, 1.3rem);
  }

  :global(html.motion) .page__body {
    position: relative;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: start;
  }

  :global(html.motion) .page__period,
  :global(html.motion) .page__role,
  :global(html.motion) .page__detail {
    clip-path: inset(-0.75rem 104% -0.75rem -0.75rem);
    transition: clip-path 0.65s var(--ease-ink);
  }

  :global(html.motion) .page__role {
    transition-delay: 0.08s;
  }

  :global(html.motion) .page__detail {
    transition-delay: 0.16s;
  }

  :global(html.motion .is-read) .page__period,
  :global(html.motion .is-read) .page__role,
  :global(html.motion .is-read) .page__detail {
    clip-path: inset(-0.75rem -0.75rem -0.75rem -0.75rem);
  }

  @media (max-width: 52rem) {
    :global(html.motion) .page__body {
      grid-template-columns: 1fr;
    }

    :global(html.motion) .page__list li {
      font-size: clamp(0.92rem, 2.2svh, 1.05rem);
    }

    :global(html.motion) .page__year {
      margin-top: clamp(0.6rem, 2svh, 1.25rem);
      font-size: clamp(3.25rem, min(38cqi, 11svh), 8rem);
    }

    :global(html.motion) .page__next {
      margin-top: 0.75rem;
    }
  }

  @media (max-height: 40rem) {
    :global(html.motion) .page {
      gap: 0.75rem;
      padding-top: 1rem;
    }

    :global(html.motion) .page__company {
      font-size: 1.9rem;
    }

    :global(html.motion) .page__list {
      gap: 0.4rem;
    }

    :global(html.motion) .page__list li {
      font-size: clamp(0.82rem, 3.4svh, 1rem);
      line-height: 1.35;
    }
  }

  @media (max-height: 40rem) and (max-width: 52rem) {
    :global(html.motion) .page__year {
      margin-top: 0.4rem;
      font-size: clamp(2.75rem, min(38cqi, 9svh), 5rem);
    }
  }
</style>
