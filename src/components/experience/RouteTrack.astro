---
import type { Route } from '@/lib/route';

interface Props {
  route: Route;
  names: readonly string[];
  label: string;
  today: string;
}

const { route, names, label, today } = Astro.props;
---

<nav class="track" aria-label={label} data-route-track style={`--today: ${route.todayLeft}%`}>
  <svg class="track__lines" viewBox={route.viewBox} preserveAspectRatio="none" aria-hidden="true">
    {route.ticks.map((tick) => <path class="ink track__tick" d={tick} />)}
    {route.mainInk.map((line) => <path class="ink" d={line} />)}
    {route.branches.map((branch) => <path class="ink" d={branch.ink} />)}
    <path class="ink track__today" d={route.todayLine}></path>
    <path class="ink track__pen" pathLength="1" d={route.pen}></path>
    {route.branches.map((branch) => <path class="ink track__pen track__drop" pathLength="1" data-route-drop={branch.index} d={branch.pen} />)}
  </svg>

  <span class="track__now hand" aria-hidden="true">{today}</span>
  {route.openLanes.map((lane) => <span class:list={['track__open', `track__open--${lane}`]} aria-hidden="true" />)}

  <ol class="track__stops">
    {
      route.stops.map((stop, index) => (
        <li class:list={['track__stop', `track__stop--${stop.lane}`]} style={`--x: ${stop.dotLeft}%`} data-route-stop data-pen={stop.penStop}>
          <a href={`#exp-${stop.id}`} data-route-go={index}>
            <span class="track__dot" aria-hidden="true" />
            <span class="track__name">{names[index]}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .track {
    --track-h: 7.5rem;
    --axis: 50%;
    --siding: 70%;
    display: none;
    position: relative;
    height: var(--track-h);
  }

  .track::before {
    content: '';
    position: absolute;
    inset: calc(var(--axis) - 1px) calc(var(--edge) * -1) auto 0;
    height: 2px;
    background-image: radial-gradient(circle, var(--ink-faint) 1px, transparent 1.3px);
    background-size: 9px 2px;
  }

  .track__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .track__tick {
    stroke: var(--ink-faint);
    stroke-width: 1.5;
  }

  .track__today {
    stroke: var(--blue);
    stroke-width: 1.5;
  }

  .track__pen {
    vector-effect: none;
    stroke: var(--marker);
    stroke-width: 4.5;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--pen, 0));
  }

  .track__drop {
    stroke-dashoffset: calc(1 - var(--drawn, 0));
  }

  .track__now {
    position: absolute;
    left: var(--today);
    top: -0.35rem;
    translate: -50% 0;
    font-size: var(--hand-tag);
  }

  .track__open {
    position: absolute;
    left: var(--today);
    top: var(--axis);
    width: 0.6rem;
    height: 0.6rem;
    border: solid var(--ink);
    border-width: 2.5px 2.5px 0 0;
    border-radius: 1px;
    translate: -85% -50%;
    rotate: 45deg;
  }

  .track__open--branch {
    top: var(--siding);
  }

  .track__stops {
    position: absolute;
    inset: 0;
  }

  .track__stop {
    position: absolute;
    left: var(--x);
    top: var(--axis);
  }

  .track__stop--branch {
    top: var(--siding);
  }

  .track__stop a {
    position: absolute;
    inset: 0 auto auto 0;
    color: var(--fg-soft);
    text-decoration: none;
    transition: color var(--state);
  }

  .track__dot {
    position: absolute;
    inset: 0 auto auto 0;
    width: 0.8rem;
    height: 0.8rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--bg);
    translate: -50% -50%;
    transition:
      background-color var(--state),
      scale 0.3s var(--ease-snap);
  }

  .track__name {
    position: absolute;
    left: -0.5rem;
    bottom: 0.6rem;
    padding: 0.3rem 0.5rem;
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .track__stop--branch .track__name {
    top: 0.6rem;
    bottom: auto;
  }

  .track__stop a:hover,
  .track__stop.is-active a {
    color: var(--fg);
  }

  .track__stop a:hover .track__name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .track__stop a:focus-visible {
    outline: none;
  }

  .track__stop a:focus-visible .track__name {
    outline: 3px solid var(--focus);
    outline-offset: 0;
    border-radius: 2px;
  }

  .track__stop.is-past .track__dot {
    background: var(--ink);
  }

  .track__stop.is-active .track__dot {
    background: var(--marker);
    scale: 1.3;
  }

  @media (min-width: 52rem) and (orientation: landscape) and (min-height: 42rem) {
    :global(html.motion) .track {
      display: block;
    }
  }
</style>
