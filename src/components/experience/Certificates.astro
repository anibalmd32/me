---
import DiplomaCard from './DiplomaCard.astro';
import { DIPLOMA_IMAGES } from '@/data/certificates';
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const e = t.experience;
const diplomas = e.certs.flatMap((cert) => {
  const image = DIPLOMA_IMAGES[cert.id];
  return image ? [{ cert, image }] : [];
});
---

<div class="certs" data-tone="desk">
  <div class="certs__inner wrap">
    <h3 class="display h3">{e.certTitle}</h3>
    <ul class="certs__list">
      {
        diplomas.map(({ cert, image }, index) => (
          <DiplomaCard
            title={cert.title}
            issuer={cert.issuer}
            when={cert.when}
            url={cert.url}
            image={image}
            alt={e.certAlt.replace('{issuer}', cert.issuer).replace('{title}', cert.title)}
            viewLabel={e.certView}
            index={index}
          />
        ))
      }
    </ul>
  </div>
</div>

<style>
  .certs {
    margin-top: -1px;
    overflow-x: clip;
    padding-block: clamp(2.5rem, 7vw, 5rem) var(--section-gap);
    box-shadow: inset 0 -1rem 1.25rem -1rem rgb(var(--shadow) / 0.3);
  }

  .certs__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 3.25rem);
  }

  .certs__list {
    display: grid;
    gap: clamp(2rem, 6vw, 2.75rem);
    justify-items: center;
  }

  @media (min-width: 56rem) {
    .certs__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      align-items: start;
      justify-items: stretch;
    }
  }
</style>
