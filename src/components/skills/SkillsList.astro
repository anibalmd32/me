---
import Icon from '../Icon.astro';
import { sketchLine } from '@/lib/sketch';
import { SKILL_GROUPS } from '@/data/skills';
import { placesOf } from '@/lib/skills-map';
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const groups = SKILL_GROUPS.map((group) => ({
  id: group.id,
  label: t.skills.groups[group.id],
  tools: group.tools.map((tool) => ({
    id: tool,
    name: t.skills.tools[tool],
    links: placesOf(tool).map((place) => place.id),
  })),
}));
const rule = (seed: string) => sketchLine([0, 6], [1000, 6], seed, 0.5);
---

<dl class="list">
  {
    groups.map((group, index) => (
      <div class="list__row" data-ink data-group style={`--d: ${index * 0.06}s`}>
        <dt class="hand">{group.label}</dt>
        <dd>
          <ul>
            {group.tools.map((tool) => (
              <li>
                {tool.links.length > 0 ? (
                  <button class="tool" type="button" aria-pressed="false" data-pick data-kind="tool" data-id={tool.id} data-name={tool.name} data-links={tool.links.join(' ')}>
                    {tool.name}
                  </button>
                ) : (
                  <span class="tool">{tool.name}</span>
                )}
              </li>
            ))}
          </ul>
          <p class="list__where" data-where hidden aria-hidden="true">
            <Icon name="arrow-right" />
            <span data-where-text />
          </p>
        </dd>
        <svg class="list__rule" viewBox="0 0 1000 12" preserveAspectRatio="none" aria-hidden="true">
          <path class="ink ink-draw" pathLength="1" d={rule(`skills-${index}`)} />
        </svg>
      </div>
    ))
  }
  <div class="list__row" data-ink style={`--d: ${groups.length * 0.06}s`}>
    <dt class="hand">{t.skills.spoken.label}</dt>
    <dd>
      <ul>
        {t.skills.spoken.items.map((item) => (
          <li>
            <span class="tool">{item}</span>
          </li>
        ))}
      </ul>
    </dd>
    <svg class="list__rule" viewBox="0 0 1000 12" preserveAspectRatio="none" aria-hidden="true">
      <path class="ink ink-draw" pathLength="1" d={rule('skills-spoken')} />
    </svg>
  </div>
</dl>

<style>
  .list {
    margin: 0;
  }

  .list__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(6.5rem, 9.5rem) minmax(0, 1fr);
    align-items: baseline;
    gap: 0.25rem clamp(1rem, 3vw, 2.25rem);
    padding-block: 1.05rem 1.25rem;
  }

  .list__row dt {
    justify-self: start;
  }

  .list__row dd {
    margin: 0;
  }

  .list__row ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem clamp(1rem, 2.2vw, 1.75rem);
  }

  .tool {
    display: inline-block;
    margin: -0.3rem -0.2rem;
    padding: 0.3rem 0.2rem;
    border: 0;
    border-radius: 0.08em 0.22em 0.1em 0.2em;
    background-color: transparent;
    background-image: linear-gradient(var(--blue), var(--blue));
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: 0 86%;
    color: inherit;
    font: inherit;
    font-size: clamp(1.1rem, 1.55vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    text-align: start;
    transition:
      background-size 0.3s var(--ease-ink),
      color var(--state);
  }

  button.tool {
    cursor: pointer;
  }

  button.tool:not(.is-picked):hover,
  .tool.is-linked {
    background-size: 100% 2px;
  }

  .tool.is-linked {
    color: var(--blue);
  }

  .tool.is-picked {
    color: var(--mark-fg);
    background-image: linear-gradient(var(--mark-bg), var(--mark-bg));
    background-size: 100% var(--mark-size);
    background-position: 0 var(--mark-pos);
  }

  .list__where {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.6rem;
    color: var(--blue);
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.35;
  }

  .list__where[hidden] {
    display: none;
  }

  .list__where :global(svg) {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
  }

  .list__rule {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 8px;
    color: var(--ink);
    opacity: 0.55;
    overflow: visible;
  }

  .list__rule .ink {
    stroke-width: 2.4;
  }

  @media (max-width: 40rem) {
    .list__row {
      grid-template-columns: 1fr;
    }
  }
</style>
