---
import { sketchLine } from '@/lib/sketch';
import type { TimelineRow } from '@/lib/skills-map';

interface Props {
  row: TimelineRow;
  name: string;
  today: string;
  index: number;
}

const { row, name, today, index } = Astro.props;
const selectable = row.tools.length > 0;
const line = sketchLine([1, 6], [99, 6], `where-${row.place.id}`, 0.45);
const lastYear = row.ongoing ? today : String(row.lastYear);
const period = String(row.firstYear) === lastYear ? lastYear : `${row.firstYear} – ${lastYear}`;
---

<li class:list={['row', row.brief && 'row--brief']} data-ink style={`--from: ${row.start.toFixed(4)}; --to: ${row.end.toFixed(4)}; --d: ${(index * 0.07).toFixed(2)}s`}>
  {
    selectable ? (
      <button class="row__name" type="button" aria-pressed="false" data-pick data-kind="place" data-id={row.place.id} data-name={name} data-links={row.tools.join(' ')}>
        {name}
        <span class="sr-only">, {period}</span>
      </button>
    ) : (
      <span class="row__name">
        {name}
        <span class="sr-only">, {period}</span>
      </span>
    )
  }
  <span class="row__track" aria-hidden="true">
    {
      row.brief ? (
        <span class="row__dot" />
      ) : (
        <svg class="row__line" viewBox="0 0 100 12" preserveAspectRatio="none">
          <path class="ink ink-draw" pathLength="1" d={line} />
        </svg>
      )
    }
    {
      row.ongoing && (
        <svg class="row__arrow" viewBox="0 0 12 14" width="12" height="14">
          <path class="ink" d="M2 2 10 7 2 12" />
        </svg>
      )
    }
  </span>
</li>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: var(--label) minmax(0, 1fr);
    align-items: center;
    min-height: 2.5rem;
    transition: color var(--state);
  }

  .row__name {
    justify-self: start;
    max-width: 100%;
    padding: 0.15rem 0.2rem;
    margin-inline: -0.2rem;
    border: 0;
    border-radius: 0.08em 0.22em 0.1em 0.2em;
    background: none;
    color: inherit;
    font: inherit;
    font-size: clamp(0.92rem, 1.15vw, 1.02rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
    text-align: start;
  }

  button.row__name {
    cursor: pointer;
  }

  button.row__name::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row__name.is-picked {
    color: var(--mark-fg);
    background-image: linear-gradient(var(--mark-bg), var(--mark-bg));
    background-repeat: no-repeat;
    background-size: 100% var(--mark-size);
    background-position: 0 var(--mark-pos);
  }

  .row:has(.is-linked) {
    color: var(--blue);
  }

  .row__track {
    position: relative;
    align-self: stretch;
  }

  .row__line {
    position: absolute;
    top: 50%;
    left: calc(var(--from) * 100%);
    width: calc((var(--to) - var(--from)) * 100%);
    height: 12px;
    translate: 0 -50%;
    overflow: visible;
  }

  .row__line .ink {
    stroke-width: 5;
  }

  .row__dot {
    position: absolute;
    top: 50%;
    left: calc(var(--from) * 100%);
    width: 0.7rem;
    height: 0.7rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: currentColor;
  }

  .row__arrow {
    position: absolute;
    top: 50%;
    left: calc(var(--to) * 100% + 2px);
    translate: 0 -50%;
  }

  .row--brief .row__arrow {
    left: calc(var(--from) * 100% + 0.55rem);
  }

  .row__arrow .ink {
    stroke-width: 2.6;
  }

  button.row__name:not(.is-picked):hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
</style>
