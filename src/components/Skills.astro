---
import SkillFigure from './skills/SkillFigure.astro';
import { SKILL_GROUPS } from '@/data/skills';
import { figureFor } from '@/lib/figures';
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const s = t.skills;
const FIGURES_IN_FIRST_ROW = 5;
const toolFigures = SKILL_GROUPS.map((group) => ({
  shape: figureFor(group.id, group.tools.length),
  label: s.groups[group.id],
  items: group.tools.map((tool) => ({ name: s.tools[tool], tool })),
}));
const spokenFigure = {
  shape: figureFor('spoken', s.spoken.items.length),
  label: s.spoken.label,
  items: s.spoken.items.map((name) => ({ name })),
};
const figures = [...toolFigures, spokenFigure];
---

<div class="flow skills wrap">
  <header class="skills__head">
    <h2 class="display h2">
      {s.pre}<mark>{s.mark}</mark>{s.post}
    </h2>
    <p class="lead soft">{s.lead}</p>
  </header>

  <div class="skills__frame">
    <ul class="skills__shelf">
      {figures.map((figure, index) => <SkillFigure {...figure} order={index % FIGURES_IN_FIRST_ROW} />)}
    </ul>
  </div>
</div>

<style>
  .skills {
    display: grid;
    gap: var(--block-gap);
    padding-bottom: 0;
  }

  .skills__head {
    display: grid;
    gap: 0.75rem;
  }

  .skills__frame {
    container: shelf / inline-size;
  }

  .skills__shelf {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 2rem 1.5rem;
  }

  @container shelf (max-width: 40rem) {
    .skills__shelf {
      justify-content: center;
    }
  }

  @container shelf (min-width: 66rem) {
    .skills__shelf {
      justify-content: space-between;
      gap: 2.5rem 1rem;
    }
  }
</style>
