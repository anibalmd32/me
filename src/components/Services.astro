---
import ServiceFlyer from './services/ServiceFlyer.astro';
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const s = t.services;
---

<section id="services" data-page="4" data-topic={t.header.topics.services}>
  <div class="scene scene--join serv" data-scene="services" style="--len: 215">
    <div class="stage" data-tone="code">
      <div class="serv__ask wrap">
        <p class="display h2">{s.lead}</p>
      </div>

      <div class="serv__note" data-tone="sticky" aria-hidden="true"></div>
      <div class="serv__label" aria-hidden="true">
        <span class="tape"></span>
        <span class="serv__word">{s.note}</span>
      </div>

      <div class="serv__final" data-tone="sticky">
        <div class="wrap">
          <h2 class="display h2">{s.title}</h2>
          <p class="lead">{s.intro}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="serv-list" data-tone="sticky">
    <div class="wrap">
      <ServiceFlyer t={t} />
    </div>
  </div>
</section>

<style>
  /* ---------- Static ---------- */
  .serv .stage {
    padding-block: var(--section-gap) 0;
  }

  .serv__ask {
    padding-bottom: var(--section-gap);
  }

  .serv__ask .h2 {
    max-width: 16em;
  }

  .serv__note,
  .serv__label {
    display: none;
  }

  .serv__final {
    padding-block: var(--section-gap) 0;
  }

  .serv__final .wrap {
    display: grid;
    gap: 1rem;
  }

  .serv-list {
    padding-block: var(--block-gap) var(--section-gap);
  }

  /* ---------- Motion: a small sticky note comes at you until it is the page ---------- */
  :global(html.motion) .serv {
    --g: clamp(0, calc((var(--p, 0) - 0.08) / 0.5), 1);
    --g2: calc(var(--g) * var(--g));
    /* the heading is written on the note once its own label has gone */
    --arrive: clamp(0, calc((var(--g) - 0.3) / 0.3), 1);
    --nx: 70%;
    --ny: 55%;
    --ns: 24vmin;
  }

  :global(html.motion) .serv .stage {
    padding: 0;
  }

  :global(html.motion) .serv__ask {
    position: absolute;
    inset: var(--header-h) 0 0 0;
    display: grid;
    align-content: center;
    padding-bottom: 8svh;
    opacity: calc(1 - clamp(0, calc((var(--p, 0) - 0.18) / 0.16), 1));
  }

  :global(html.motion) .serv__ask .h2 {
    max-width: min(16em, 54%);
  }

  :global(html.motion) .serv__note {
    display: block;
    position: absolute;
    left: var(--nx);
    top: var(--ny);
    width: var(--ns);
    height: var(--ns);
    translate: -50% -50%;
    rotate: calc((1 - var(--g)) * -5deg);
    scale: calc(1 + var(--g2) * 19);
    border-bottom-right-radius: 1.4vmin;
  }

  /* The shadow lives on its own layer and is gone before the note gets big:
     a blurred shadow scaled twenty times would be repainted on every frame. */
  :global(html.motion) .serv__note::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    box-shadow:
      0 1.4vmin 2.4vmin rgb(0 0 0 / 0.28),
      0 2px 0 rgb(0 0 0 / 0.05);
    opacity: calc(1 - var(--g) * 7);
  }

  :global(html.motion) .serv__label {
    display: grid;
    place-items: center;
    position: absolute;
    left: var(--nx);
    top: var(--ny);
    width: var(--ns);
    height: var(--ns);
    translate: -50% -50%;
    rotate: calc((1 - var(--g)) * -5deg);
    scale: calc(1 + var(--g2) * 6);
    opacity: calc(1 - var(--g) * 3.2);
    pointer-events: none;
  }

  .serv__label .tape {
    top: -0.7rem;
    left: 50%;
    width: 46%;
    translate: -50% 0;
    rotate: -3deg;
  }

  .serv__word {
    font-family: var(--font-hand), cursive;
    font-weight: 700;
    font-size: calc(var(--ns) * 0.2);
    color: var(--c-ink);
  }

  :global(html.motion) .serv__final {
    position: absolute;
    inset: auto 0 clamp(2.5rem, 9svh, 5.5rem) 0;
    padding: 0;
    background: none;
    /* --sx/--sy (scroll.ts): from this block's resting place to the note. It
       grows with the note, from inside it, to where the list will follow. */
    transform-origin: 50% 50%;
    transform: translate(calc((1 - var(--g2)) * var(--sx, 0px)), calc((1 - var(--g2)) * var(--sy, 0px)))
      scale(calc(0.1 + 0.9 * var(--g2)));
    clip-path: inset(-12% calc((1 - var(--arrive)) * 104%) -12% -2%);
  }

  @media (max-width: 52rem) {
    :global(html.motion) .serv {
      --nx: 50%;
      --ny: 66%;
      --ns: 34vmin;
    }

    :global(html.motion) .serv__ask {
      align-content: start;
      padding-top: 9svh;
    }

    :global(html.motion) .serv__ask .h2 {
      max-width: 100%;
    }
  }
</style>
