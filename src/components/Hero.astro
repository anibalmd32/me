---
import Icon from './Icon.astro';
import ScrollHint from './ScrollHint.astro';
import { cubeTiles, cubeViewBox } from '@/lib/cube';
import { sketchArrow } from '@/lib/sketch';
import { SITE, type Lang } from '@/data/site';
import type { Dictionary } from '@/i18n';

interface Props {
  lang: Lang;
  t: Dictionary;
}

const { lang, t } = Astro.props;

/* Static isometric drawing of the cube: first paint, no-JS and
   reduced-motion fallback for the WebGL scene. */
const tiles = cubeTiles();
const vb = cubeViewBox;

const arrow = sketchArrow([4, 34], [150, 16], 'hero-arrow', -0.22, 20);
---

<section id="top" class="hero-page" data-page="1" data-topic={t.header.topics.hero}>
  <div class="scene hero" data-scene="hero" style="--len: 260">
    <div class="stage">
      <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
      <div class="hero__wash" aria-hidden="true"></div>

      {/* The same words as the about block, printed on the marked face of the
          cube: hero3d.ts keeps this layer glued to that face while it grows,
          so the orange always has something written on it. A visual copy only. */}
      <div class="hero__face" aria-hidden="true">
        <div class="hero__about wrap">
          <div class="hero__about-text">
            <p class="hero__about-title display">{t.about.pre}{t.about.mark}{t.about.post}</p>
            <p class="hero__about-body lead">{t.about.body}</p>
          </div>
          <ul class="hero__sticky hero__sticky--ghost">
            {t.about.sticky.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>

      <div class="hero__copy wrap" data-live="0,0.2">
        <div class="hero__col">
          <h1 class="hero__title display">
            {t.hero.pre}<mark class="hero__mark">{t.hero.mark}</mark>{t.hero.post}
          </h1>
          <p class="hero__note">
            <span class="hand">{t.hero.note}</span>
            <svg class="hero__arrow" viewBox="0 0 160 50" width="160" height="50" aria-hidden="true">
              <path class="ink" d={arrow.shaft}></path>
              <path class="ink" d={arrow.head}></path>
            </svg>
          </p>
          <p class="lead">{t.hero.lead}</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="#projects">
              {t.hero.ctaProjects}
              <Icon name="arrow-down" />
            </a>
            {
              SITE.cvDownload ? (
                <a class="btn" href={SITE.cv[lang]} download>
                  <Icon name="download" />
                  {t.hero.ctaCv}
                </a>
              ) : (
                <a class="btn" href="#contact-form">
                  <Icon name="send" />
                  {t.hero.ctaContact}
                </a>
              )
            }
          </div>
        </div>
        {/* Free area of the layout: the static drawing sits here and the WebGL cube aligns to it. */}
        <div class="hero__slot" data-hero-slot aria-hidden="true">
          <svg class="hero__fallback" viewBox={vb} role="presentation">
            {tiles.map((tile) => <polygon class:list={[`f-${tile.face}`, { 'f-key': tile.key }]} points={tile.points} />)}
          </svg>
        </div>
      </div>

      <ScrollHint text={t.hero.hint} seed="hero-hint" />

      <div class="hero__about hero__about--real wrap" data-live="0.58,1">
        <div class="hero__about-text">
          <h2 class="hero__about-title display">
            {t.about.pre}<mark data-hero-mark>{t.about.mark}</mark>{t.about.post}
          </h2>
          <p class="hero__about-body lead">{t.about.body}</p>
        </div>
        <ul class="hero__sticky" data-tone="sticky" data-card>
          <li class="tape" aria-hidden="true"></li>
          {t.about.sticky.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Static (no JS / reduced motion): plain stacked page ---------- */
  .hero .stage {
    padding-top: calc(var(--header-h) + clamp(2rem, 6vw, 4rem));
  }

  .hero__title {
    font-size: clamp(2.4rem, min(5.7vw, 9.4svh), 5rem);
  }

  /* The marked words are the slogan: they never break across two lines. */
  .hero__mark {
    white-space: nowrap;
    animation: mark-in 0.5s var(--ease-ink) 0.35s both;
  }

  @keyframes mark-in {
    from {
      background-size: 0% var(--mark-size);
    }
  }

  .hero__col {
    display: grid;
    gap: clamp(1rem, 2.4svh, 1.6rem);
    max-width: 44rem;
  }

  .hero__note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: -0.25rem;
    color: var(--blue);
  }

  .hero__arrow {
    width: clamp(5.5rem, 10vw, 10rem);
    height: auto;
    flex: none;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .hero__slot {
    width: min(70vw, 22rem);
    margin: 2.5rem auto 0;
  }

  .hero__fallback {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hero__fallback polygon {
    stroke: var(--ink);
    stroke-width: 2.2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .f-top {
    fill: var(--paper);
  }

  .f-x {
    fill: var(--paper-shade);
  }

  .f-z {
    fill: color-mix(in srgb, var(--paper), var(--blue) 13%);
  }

  .f-key.f-top {
    fill: var(--marker-solid);
  }

  .f-key.f-x {
    fill: color-mix(in srgb, var(--marker-solid), var(--marker) 22%);
  }

  .f-key.f-z {
    fill: color-mix(in srgb, var(--marker-solid), var(--marker) 42%);
  }

  .hero__canvas,
  .hero__wash,
  .hero__face {
    display: none;
  }

  .hero__about {
    display: grid;
    gap: 1.5rem;
    padding-block: var(--section-gap) 0;
  }

  .hero__about-text {
    display: grid;
    gap: 1.5rem;
  }

  /* The practical facts, on a sticky note */
  .hero__sticky {
    position: relative;
    justify-self: start;
    display: grid;
    gap: 0.15rem;
    min-width: 11.5rem;
    padding: 2.1rem 1.6rem 1.5rem;
    border-bottom-right-radius: 1.2rem;
    box-shadow: var(--shadow-note);
    align-self: center;
    rotate: 3deg;
    font-family: var(--font-hand), cursive;
    font-weight: 700;
    font-size: 1.85rem;
    line-height: 1.08;
  }

  .hero__sticky .tape {
    top: -0.75rem;
    left: 50%;
    translate: -50% 0;
    rotate: -4deg;
  }

  .hero__about-title {
    max-width: 22em;
    font-size: clamp(1.9rem, 4.3vw, 3.5rem);
    line-height: 1.06;
  }

  /* One marker at a time. Without the pinned scene the headline above already
     carries it, so these words stay plain; with motion on they are where the
     hero's wash lands (see below). */
  .hero__about-title mark {
    color: inherit;
    background-image: none;
  }

  :global(html.motion) .hero__about-title mark {
    color: var(--mark-fg);
    background-image: linear-gradient(var(--mark-bg), var(--mark-bg));
  }

  /* ---------- Motion: pinned scene, driven by --p (0..1) ---------- */
  :global(html.motion) .hero {
    --out: clamp(0, calc(var(--p, 0) / 0.2), 1);
    /* 1. As soon as the marked face turns towards the reader, the about text
          is written on it and grows with it (hero3d.ts sets --fs/--fx/--fy). */
    --face-in: clamp(0, calc((var(--p, 0) - 0.47) / 0.1), 1);
    --face-in-2: clamp(0, calc((var(--p, 0) - 0.53) / 0.09), 1);
    /* 2. When the face covers the screen a flat wash of the same colour takes
          over from the canvas. */
    --wash-in: clamp(0, calc((var(--p, 0) - 0.56) / 0.02), 1);
    --wash-full: clamp(0, calc((var(--p, 0) - 0.58) / 0.02), 1);
    /* 3. The wash does not fade: it closes in on the marked words of the
          headline (--wt/--wr/--wb/--wl come from scroll.ts) and stays as their
          highlight. The marker that opened the page lands on its point. */
    --wash-out: clamp(0, calc((var(--p, 0) - 0.61) / 0.11), 1);
    --wash-end: clamp(0, calc((var(--p, 0) - 0.72) / 0.05), 1);
    /* --land and --land-2 only write the text when there is no WebGL (below) */
    --land: clamp(0, calc((var(--p, 0) - 0.48) / 0.25), 1);
    --land-2: clamp(0, calc((var(--p, 0) - 0.6) / 0.25), 1);
    --land-3: clamp(0, calc((var(--p, 0) - 0.74) / 0.08), 1);
    --wash-clip: inset(
      calc(var(--wash-out) * var(--wt, 45%)) calc(var(--wash-out) * var(--wr, 45%))
        calc(var(--wash-out) * var(--wb, 45%)) calc(var(--wash-out) * var(--wl, 10%)) round
        calc(var(--wash-out) * 5px)
    );
  }

  /* No WebGL: nothing to dive into, so the scene is shorter and the copy
     hands over to the about text directly. */
  :global(html.motion) .hero.no-3d {
    --len: 190 !important;
    --out: clamp(0, calc(var(--p, 0) / 0.42), 1);
    --land: clamp(0, calc((var(--p, 0) - 0.48) / 0.25), 1);
    --land-2: clamp(0, calc((var(--p, 0) - 0.6) / 0.25), 1);
    --land-3: clamp(0, calc((var(--p, 0) - 0.74) / 0.18), 1);
  }

  :global(html.motion) .hero.no-3d .hero__fallback {
    scale: calc(1 + var(--out) * 0.6);
    transform-origin: 50% 50%;
  }

  :global(html.motion) .hero .stage {
    padding-top: 0;
  }

  :global(html.motion) .hero__copy {
    position: absolute;
    z-index: 5;
    inset: var(--header-h) 0 0 0;
    display: grid;
    grid-template-columns: minmax(0, 57fr) minmax(0, 43fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    padding-bottom: 5svh;
    opacity: calc(1 - var(--out));
    translate: 0 calc(var(--out) * -7svh);
  }

  :global(html.motion) .hero__col {
    max-width: 44rem;
  }

  /* hero3d.ts reads this box and draws the cube exactly where the static one is. */
  :global(html.motion) .hero__slot {
    width: auto;
    height: min(100%, 60svh);
    margin: 0;
  }

  :global(html.motion) .hero__fallback {
    height: 100%;
    transition: opacity 0.4s linear;
  }

  :global(html.motion) .hero__canvas {
    display: block;
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s linear;
  }

  :global(html.motion) .hero.is-3d .hero__canvas {
    opacity: calc(1 - var(--wash-full));
  }

  :global(html.motion) .hero.is-3d .hero__fallback {
    opacity: 0;
  }

  @media (max-height: 36rem) and (max-width: 52rem) {
    :global(html.motion) .hero__copy .lead {
      display: none;
    }
  }

  /* Short phones: the about text and its note get a little tighter so the
     pinned page always holds them. */
  @media (max-height: 43rem) and (max-width: 52rem) {
    :global(html.motion) .hero__about {
      gap: 1rem;
    }

    :global(html.motion) .hero__about-text {
      gap: 0.9rem;
    }

    :global(html.motion) .hero__about .lead {
      font-size: 0.95rem;
      line-height: 1.42;
    }

    :global(html.motion) .hero__sticky {
      min-width: 0;
      padding: 1.6rem 1.25rem 1rem;
      font-size: 1.5rem;
    }
  }

  /* The marker-filled module fills the screen, then closes in on three words. */
  :global(html.motion) .hero__wash {
    display: block;
    position: absolute;
    z-index: 3;
    inset: 0;
    pointer-events: none;
    background: var(--hero-wash, var(--marker-solid));
    opacity: calc(var(--wash-in) - var(--wash-end));
    clip-path: var(--wash-clip);
  }

  /* The text on the orange: glued to the cube's face while it grows, then
     clipped with the wash, so inside the marker it is always dark ink (the
     real block underneath keeps the page's own colours outside it). */
  :global(html.motion) .hero__face {
    display: block;
    position: absolute;
    z-index: 4;
    inset: 0;
    pointer-events: none;
    color: var(--c-ink);
    transform-origin: 50% 50%;
    transform: translate(calc(var(--fx, 0) * 1px), calc(var(--fy, 0) * 1px)) scale(var(--fs, 1));
    opacity: calc(1 - var(--wash-end));
    clip-path: var(--wash-clip);
  }

  :global(html.motion) .hero__face .hero__about-title {
    clip-path: inset(-12% calc((1 - var(--face-in)) * 104%) -12% -4%);
  }

  :global(html.motion) .hero__face .hero__about-body {
    clip-path: inset(-6% calc((1 - var(--face-in-2)) * 104%) -6% -2%);
  }

  /* Keeps the copy's layout identical to the real block; never shown. */
  .hero__sticky--ghost {
    visibility: hidden;
  }

  :global(html.motion) .hero:not(.is-3d) .hero__wash,
  :global(html.motion) .hero:not(.is-3d) .hero__face {
    display: none;
  }

  :global(html.motion) .hero :global(.scroll-hint) {
    position: absolute;
    z-index: 5;
    inset: auto 0 2.5svh 0;
    opacity: calc(1 - var(--out) * 3);
  }

  :global(html.motion) .hero__about {
    position: absolute;
    z-index: 1;
    inset: var(--header-h) 0 0 0;
    align-content: center;
    align-items: center;
    padding-block: 0 4svh;
  }

  /* With WebGL the real block waits under the canvas and the wash, already
     complete, and is uncovered when the wash closes. It switches on while it
     is fully covered, so this is never seen as a fade. Opacity, never
     visibility or display: the text must stay in the accessibility tree and
     in find-in-page wherever the scroll is. */
  :global(html.motion) .hero.is-3d .hero__about--real {
    opacity: var(--wash-full);
  }

  :global(html.motion) .hero.is-3d .hero__copy.is-off {
    opacity: 0;
  }

  /* Without WebGL there is no wash: the text is written onto the page. */
  :global(html.motion) .hero:not(.is-3d) .hero__about--real .hero__about-title {
    clip-path: inset(-12% calc((1 - var(--land)) * 104%) -12% -4%);
  }

  :global(html.motion) .hero:not(.is-3d) .hero__about--real .hero__about-body {
    clip-path: inset(-6% calc((1 - var(--land-2)) * 104%) -6% -2%);
  }

  /* The note is pressed onto the page last */
  :global(html.motion) .hero__sticky {
    opacity: clamp(0, calc(var(--land-3) * 6), 1);
    rotate: calc(3deg - (1 - var(--land-3)) * 9deg);
    scale: calc(1 + (1 - var(--land-3)) * 0.18);
  }

  @media (min-width: 62rem) {
    .hero__about {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: clamp(2rem, 6vw, 6rem);
    }

    .hero__sticky {
      justify-self: end;
    }
  }

  /* Stacked layout: copy on top, the cube underneath. */
  @media (max-aspect-ratio: 21/20), (max-width: 52rem) {
    :global(html.motion) .hero__copy {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(7.5rem, 1fr);
      align-items: start;
      gap: 0.75rem;
      padding-top: clamp(0.75rem, 3svh, 2.5rem);
      padding-bottom: 2svh;
    }

    :global(html.motion) .hero__col {
      max-width: 100%;
      gap: clamp(0.7rem, 1.8svh, 1.25rem);
    }

    :global(html.motion) .hero__slot {
      height: 100%;
    }

    .hero__title {
      font-size: clamp(1.9rem, min(9.2vw, 5.6svh), 3.4rem);
    }

    .hero__arrow,
    :global(html.motion) .hero :global(.scroll-hint) {
      display: none;
    }

    :global(html.motion) .hero .lead {
      font-size: clamp(0.95rem, 2.1svh, 1.05rem);
      line-height: 1.45;
    }

    :global(html.motion) .hero__actions {
      flex-wrap: nowrap;
      gap: 0.5rem;
    }

    :global(html.motion) .hero__actions .btn {
      flex: 1 1 0;
      min-width: 0;
      padding-inline: 0.6em;
      font-size: 0.95rem;
      white-space: nowrap;
    }
  }
</style>
