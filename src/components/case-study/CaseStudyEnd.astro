---
import Icon from '../Icon.astro';
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
  next: { title: string; href: string } | null;
  contactHref: string;
}

const { t, next, contactHref } = Astro.props;
---

<footer class="end">
  {
    next && (
      <a class="end__next" href={next.href} data-astro-prefetch>
        <span class="end__label">{t.caseStudy.next}</span>
        <span class="end__title display">
          {next.title}
          <Icon name="arrow-right" />
        </span>
      </a>
    )
  }
  <p class="end__contact">
    <span>{t.caseStudy.contact}</span>
    <a class="btn btn--primary" href={contactHref}>
      {t.caseStudy.contactCta}
      <Icon name="arrow-right" />
    </a>
  </p>
</footer>

<style>
  .end {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    justify-items: center;
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-top: 2px solid var(--ink);
    text-align: center;
  }

  .end__next {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    color: inherit;
    text-decoration: none;
  }

  .end__label {
    font-family: var(--font-hand), cursive;
    font-weight: 700;
    font-size: var(--hand-note);
    line-height: 1;
    color: var(--blue);
  }

  .end__title {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: clamp(2.4rem, 7vw, 5rem);
  }

  .end__title :global(svg) {
    width: 0.7em;
    height: 0.7em;
    transition: translate 0.3s var(--ease-out);
  }

  .end__next:hover .end__title :global(svg) {
    translate: 0.2em 0;
  }

  .end__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin: 0;
    font-weight: 700;
    font-size: 1.2rem;
  }
</style>
