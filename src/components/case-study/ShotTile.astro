---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  caption?: string;
}

const { src, alt, sizes, caption } = Astro.props;
---

<figure class="shot">
  <span class="tape shot__tape" aria-hidden="true"></span>
  <div class="shot__frame">
    <Image src={src} alt={alt} widths={[480, 720, 960, 1280]} sizes={sizes} format="webp" quality={82} loading="lazy" decoding="async" />
  </div>
  {
    caption && (
      <figcaption class="shot__note" data-tone="note">
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .shot {
    position: relative;
    height: 100%;
    margin: 0;
  }

  .shot__tape {
    top: -0.7rem;
    left: 1.5rem;
    z-index: 1;
    rotate: -5deg;
  }

  .shot__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: var(--radius-card);
    background: var(--sheet);
  }

  .shot__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .shot__note {
    position: absolute;
    left: -0.6rem;
    bottom: 1.1rem;
    max-width: min(85%, 17rem);
    padding: 0.7rem 1rem 0.8rem;
    border-bottom-right-radius: 0.9rem;
    box-shadow: var(--shadow-note);
    font-family: var(--font-hand), cursive;
    font-weight: 700;
    font-size: var(--hand-note);
    line-height: 1.05;
    color: var(--accent);
    rotate: -2.5deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion) .shot__note {
      animation: shot-stick 0.55s var(--ease-snap) 0.45s both;
    }
  }

  @keyframes shot-stick {
    from {
      opacity: 0;
      scale: 1.18;
      rotate: 3deg;
    }
  }
</style>
