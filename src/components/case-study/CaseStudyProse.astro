---
import { sketchUnderline } from '@/lib/sketch';

const stroke = (seed: string) => {
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 310 30" preserveAspectRatio="none"><path d="${sketchUnderline(300, seed, 10)}" fill="none" stroke="black" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
};
const underlines = ['chapter-a', 'chapter-b', 'chapter-c'].map(stroke);
const proseStyle = underlines.map((underline, index) => `--u${index + 1}: ${underline}`).join('; ');
---

<div class="prose" style={proseStyle}>
  <slot />
</div>

<style>
  .prose {
    max-width: 68ch;
    margin-inline: auto;
    font-size: clamp(1.08rem, 1.3vw, 1.2rem);
    line-height: 1.65;
  }

  .prose :global(h2) {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin: clamp(3rem, 7vw, 4.5rem) 0 1.4rem;
    padding-bottom: 0.34em;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h2)::after {
    content: '';
    position: absolute;
    inset: auto -3% 0 -1%;
    height: 0.4em;
    background: var(--blue);
    -webkit-mask: var(--u1) center / 100% 100% no-repeat;
    mask: var(--u1) center / 100% 100% no-repeat;
  }

  .prose :global(h2:nth-of-type(3n + 2))::after {
    -webkit-mask-image: var(--u2);
    mask-image: var(--u2);
  }

  .prose :global(h2:nth-of-type(3n))::after {
    -webkit-mask-image: var(--u3);
    mask-image: var(--u3);
  }

  .prose :global(h3) {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(blockquote) {
    margin: 0 0 1.15em;
  }

  .prose :global(li) {
    position: relative;
    margin-bottom: 0.5em;
    padding-inline-start: 1.5rem;
  }

  .prose :global(ol) {
    counter-reset: step;
  }

  .prose :global(ol > li) {
    counter-increment: step;
  }

  .prose :global(ol > li)::before {
    content: counter(step) '.';
    position: absolute;
    left: 0;
    color: var(--blue);
    font-weight: 800;
  }

  .prose :global(code) {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--blue-wash);
  }

  .prose :global(pre) {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-card);
    background: var(--code-bg) !important;
    color: var(--code-text);
    font-size: 0.92rem;
    line-height: 1.7;
    overflow-x: auto;
    scrollbar-color: var(--code-soft) transparent;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  .prose :global(blockquote) {
    padding-inline-start: 1.25rem;
    font-size: 1.15em;
    font-weight: 600;
  }

  .prose :global(p:has(> img:only-child)) {
    margin: 2.5rem 0 0.9rem;
  }

  .prose :global(p > img:only-child) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: var(--radius-card);
    background: var(--sheet);
    box-shadow: 0 1.1rem 2.2rem -0.9rem rgb(var(--shadow) / 0.28);
  }

  .prose :global(p:has(> img:only-child) + p:has(> em:only-child)) {
    margin-bottom: 2.5rem;
    color: var(--fg-soft);
    font-size: 0.92em;
    line-height: 1.5;
  }

  .prose :global(p:has(> img:only-child) + p > em:only-child) {
    font-style: normal;
  }
</style>
