---
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
  role: string;
  year: number;
}

const { t, role, year } = Astro.props;
---

<div class="facts" data-tone="sticky" data-card>
  <span class="tape facts__tape" aria-hidden="true"></span>
  <dl class="facts__list">
    <div>
      <dt>{t.caseStudy.role}</dt>
      <dd>{role}</dd>
    </div>
    <div>
      <dt>{t.caseStudy.year}</dt>
      <dd>{year}</dd>
    </div>
  </dl>
</div>

<style>
  .facts {
    position: relative;
    height: 100%;
    padding: 2rem 1.5rem 1.5rem;
    border-bottom-right-radius: 1.2rem;
    box-shadow: var(--shadow-note);
    rotate: -1.2deg;
  }

  .facts__tape {
    top: -0.75rem;
    left: 1.5rem;
    rotate: -6deg;
  }

  .facts__list {
    display: grid;
    gap: 1.1rem;
    margin: 0;
  }

  .facts__list dt {
    font-family: var(--font-hand), cursive;
    font-weight: 700;
    font-size: var(--hand-note);
    line-height: 1;
    color: var(--accent);
  }

  .facts__list dd {
    margin: 0.25rem 0 0;
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion) .facts {
      animation: facts-stick 0.55s var(--ease-snap) 0.3s both;
    }
  }

  @keyframes facts-stick {
    from {
      opacity: 0;
      scale: 1.12;
      rotate: 2.5deg;
    }
  }
</style>
