---
import TearStrips from './TearStrips.astro';
import { sketchArrow } from '@/lib/sketch';
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const s = t.services;
const other = t.contact.topics.find((topic) => topic.value === 'other');
const down = sketchArrow([8, 4], [30, 40], 'flyer-tear', 0.22, 12);
const strips = [
  ...s.items.map((item) => ({
    label: item.tab,
    name: item.title,
    topic: 'project',
    prefill: s.prefill.replace('{service}', item.title),
  })),
  ...(other ? [{ label: other.label, name: other.label, topic: other.value, prefill: '' }] : []),
];
---

<div class="flyer" data-ink data-flyer>
  <article class="flyer__paper" data-tone="note">
    <span class="tape flyer__tape flyer__tape--a" aria-hidden="true"></span>
    <span class="tape flyer__tape flyer__tape--b" aria-hidden="true"></span>

    <ul class="flyer__items">
      {
        s.items.map((item) => (
          <li class="flyer__item">
            <div class="flyer__head">
              <h3 class="h4">{item.title}</h3>
              {item.draft && <span class="draft-tag">{s.draft}</span>}
            </div>
            <p class="flyer__body">{item.body}</p>
            <ul class="flyer__includes" aria-label={s.includes}>
              {item.includes.map((included) => <li>{included}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>

    <p class="flyer__hint">
      <span class="hand">{s.tear}</span>
      <svg viewBox="0 0 40 46" width="40" height="46" aria-hidden="true">
        <path class="ink" d={down.shaft}></path>
        <path class="ink" d={down.head}></path>
      </svg>
    </p>
  </article>

  <TearStrips strips={strips} actionLabel={s.cta} />
</div>

<script>
  import { initFlyers } from '@/scripts/flyer';
  initFlyers();
</script>

<style>
  .flyer {
    position: relative;
    max-width: 68rem;
    rotate: -0.7deg;
  }

  .flyer__paper {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 2.25rem);
    padding: clamp(2rem, 4.5vw, 3.25rem) clamp(1.25rem, 4vw, 3rem) clamp(1rem, 2vw, 1.5rem);
    border-radius: var(--radius-paper) var(--radius-paper) 0 0;
    box-shadow: var(--shadow-note);
  }

  .flyer__tape {
    top: -0.75rem;
  }

  .flyer__tape--a {
    left: clamp(1rem, 6%, 4rem);
    rotate: -7deg;
  }

  .flyer__tape--b {
    right: clamp(1rem, 6%, 4rem);
    rotate: 5deg;
  }

  .flyer__items {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem) clamp(1.5rem, 3vw, 2.75rem);
  }

  .flyer__item {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .flyer__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.85rem;
  }

  .flyer__body {
    max-width: 52ch;
    line-height: 1.5;
  }

  .flyer__includes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
  }

  .flyer__includes li {
    position: relative;
    padding-inline-start: 1.35rem;
    font-weight: 700;
  }

  .flyer__includes li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.32em;
    width: 0.42rem;
    height: 0.78rem;
    border: solid var(--c-blue);
    border-width: 0 2.5px 2.5px 0;
    rotate: 40deg;
  }

  .flyer__hint {
    display: flex;
    align-items: end;
    justify-content: center;
    gap: 0.5rem;
    color: var(--c-blue);
  }

  .flyer__hint svg {
    flex: none;
    translate: 0 0.4rem;
  }

  @media (min-width: 60rem) {
    .flyer__items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion) .flyer[data-ink] {
      opacity: 0;
      scale: 1.04;
      rotate: 1.5deg;
      transition:
        opacity 0.3s linear,
        rotate 0.6s var(--ease-snap),
        scale 0.6s var(--ease-snap);
    }

    :global(html.motion) .flyer[data-ink].is-in {
      opacity: 1;
      scale: 1;
      rotate: -0.7deg;
    }
  }
</style>
