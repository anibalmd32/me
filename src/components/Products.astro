---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import StackLine from './StackLine.astro';
import { sketchArrow, sketchEllipse } from '@/lib/sketch';
import type { Dictionary } from '@/i18n';
import apartarShot from '@/assets/products/apartar.png';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const p = t.products;
const f = p.featured;
const circle = sketchEllipse(200, 80, 182, 62, 'products-circle', 1);
const up = sketchArrow([20, 44], [24, 4], 'turn-arrow', 0.16, 12);
---

<section id="products" data-page="5" data-topic={t.header.topics.products}>
  <div class="scene scene--join prod" data-scene="products" style="--len: 290">
    <div class="stage">
      <div class="prod__dim" aria-hidden="true"></div>

      <div class="prod__center">
        <h2 class="prod__title display h2">
          <span class="prod__word">
            {/* One pen stroke: it circles the word, fills with blue and keeps
                opening until the circle is the page. */}
            <svg class="prod__circle" viewBox="0 0 400 160" preserveAspectRatio="none" data-tone="blue" aria-hidden="true">
              <g class="prod__ring">
                <path class="prod__fill" d={circle}></path>
                <path class="ink prod__pen" pathLength="1" d={circle}></path>
              </g>
            </svg>
            {p.title}
          </span>
        </h2>
        <p class="prod__lead lead">{p.lead}</p>
      </div>

      <div class="prod__sheet" data-tone="sticky" aria-hidden="true">
        <p class="prod__turn">
          <svg viewBox="0 0 44 48" width="44" height="48">
            <path class="ink" d={up.shaft}></path>
            <path class="ink" d={up.head}></path>
          </svg>
          <span class="hand">{t.services.turn}</span>
        </p>
      </div>
    </div>
  </div>

  <div class="prod-list" data-tone="blue">
    <div class="wrap prod-grid">
      {/* The one that is live: a paper card with a photo of the real thing taped on it */}
      <article class="prod-card prod-feature" data-tone="note" data-ink aria-labelledby="prod-feature-name">
        <span class="tape prod-card__tape" aria-hidden="true"></span>
        <div class="prod-feature__text prod-feature__intro">
          <p class="prod-card__head">
            <span class="mono prod-card__mark" aria-hidden="true">&lt;/&gt;</span>
            <span class="prod-card__name" id="prod-feature-name">{f.name}</span>
            <span class="prod-card__kind">{f.kind}</span>
            <span class="prod-feature__live mono">{f.status}</span>
          </p>
          <h3 class="prod-card__tagline prod-feature__tagline display">{f.tagline}</h3>
        </div>

        <div class="prod-feature__text prod-feature__more">
          <p class="prod-card__body">{f.body}</p>
          <ul class="prod-feature__points dash-list">
            {f.points.map((point) => <li>{point}</li>)}
          </ul>
          <div class="prod-feature__built">
            <p>{f.built}</p>
            <StackLine label={t.projects.stack} stack={f.stack} />
          </div>
          <div class="prod-feature__go">
            <a class="btn btn--primary" href={f.link} target="_blank" rel="noopener">
              {f.linkLabel}
              <Icon name="external" />
            </a>
            {f.langNote && <p class="prod-feature__note">{f.langNote}</p>}
          </div>
        </div>

        <figure class="prod-shot">
          <span class="tape prod-shot__tape" aria-hidden="true"></span>
          <div class="prod-shot__bar" aria-hidden="true">
            <span class="prod-shot__dots"><i></i><i></i><i></i></span>
            <span class="prod-shot__url mono">apartar.app</span>
          </div>
          <Image
            class="prod-shot__img"
            src={apartarShot}
            alt={f.shotAlt}
            widths={[480, 720, 960, 1280, 1600]}
            sizes="(min-width: 60rem) min(44vw, 38rem), calc(100vw - 6rem)"
            format="webp"
            quality={82}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </article>
    </div>
  </div>
</section>

<style>
  /* ---------- Static ---------- */
  .prod .stage {
    padding-block: var(--section-gap) clamp(2.5rem, 6vw, 4rem);
  }

  .prod__dim,
  .prod__sheet,
  .prod__circle {
    display: none;
  }

  .prod__center {
    display: grid;
    gap: 1rem;
    width: min(100% - var(--gutter) * 2, var(--max));
    margin-inline: auto;
  }

  .prod__word {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  .prod-list {
    padding-block: var(--block-gap);
  }

  .prod-grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  /* A paper card taped onto the blue */
  .prod-card {
    position: relative;
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius-paper);
    box-shadow: 0 1.1rem 2rem rgb(8 14 60 / 0.35);
    rotate: -1deg;
  }

  .prod-card__tape {
    top: -0.75rem;
    left: 50%;
    translate: -50% 0;
    rotate: -3deg;
  }

  .prod-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
  }

  .prod-card__mark {
    color: var(--c-blue);
    font-weight: 700;
  }

  .prod-card__name {
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .prod-card__kind {
    color: var(--fg-soft);
  }

  .prod-card__tagline {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }

  .prod-card__body {
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.5;
  }

  /* ---------- Featured product: text on the left, the real thing on the right ---------- */
  /* Small screens: name and line, then the picture, then the details.
     Wide screens: the text in one column, the picture beside it. */
  .prod-feature {
    grid-column: 1 / -1;
    /* the column may shrink below what its widest child would like */
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'intro' 'shot' 'more';
    gap: clamp(1.5rem, 4vw, 2rem);
    rotate: -0.5deg;
  }

  .prod-feature__intro {
    grid-area: intro;
  }

  .prod-feature__more {
    grid-area: more;
  }

  .prod-shot {
    grid-area: shot;
    justify-self: stretch;
  }

  .prod-feature__text {
    display: grid;
    gap: 1rem;
    justify-items: start;
    min-width: 0;
  }

  .prod-feature__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--good);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .prod-feature__live::before {
    content: '';
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 20%, transparent);
  }

  .prod-feature__tagline {
    font-size: clamp(2rem, 3.6vw, 3.1rem);
  }

  .prod-feature__points {
    display: grid;
    gap: 0.55rem;
    max-width: 52ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prod-feature__points li {
    line-height: 1.5;
  }

  .prod-feature__built {
    display: grid;
    gap: 0.6rem;
    max-width: 52ch;
    margin-top: 0.25rem;
    color: var(--fg-soft);
  }

  .prod-feature__go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 0.5rem;
  }

  .prod-feature__note {
    color: var(--fg-soft);
    font-size: var(--text-small);
  }

  /* A printed photo of the site, taped onto the card */
  .prod-shot {
    position: relative;
    margin: 0;
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--c-ink) 18%, transparent);
    border-radius: var(--radius-sheet);
    background: #f4f5f2;
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.04),
      0 1rem 2rem -0.5rem rgb(30 25 10 / 0.22);
    rotate: 1.5deg;
  }

  .prod-shot__tape {
    top: -0.8rem;
    right: 1.5rem;
    rotate: 4deg;
    z-index: 1;
  }

  .prod-shot__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 12%, transparent);
    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
    background: #e9e6dd;
  }

  .prod-shot__dots {
    display: inline-flex;
    gap: 0.3rem;
  }

  .prod-shot__dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-ink) 22%, transparent);
  }

  .prod-shot__url {
    flex: 1;
    padding: 0.15rem 0.6rem;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.7);
    color: var(--fg-soft);
    font-size: 0.75rem;
  }

  .prod-shot__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0 0 var(--radius-sheet) var(--radius-sheet);
  }

  @media (min-width: 60rem) {
    .prod-feature {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: 'intro shot' 'more shot';
      column-gap: clamp(2.5rem, 4vw, 3.5rem);
      row-gap: 1rem;
    }

    .prod-shot {
      align-self: center;
    }
  }

  :global(html.motion) .prod-card[data-ink] {
    opacity: 0;
    scale: 1.04;
    transition:
      opacity 0.3s linear,
      scale 0.6s var(--ease-snap);
  }

  :global(html.motion) .prod-card[data-ink].is-in {
    opacity: 1;
    scale: 1;
  }

  /* ---------- Motion ----------
     1. The yellow page lifts away (the brand's page turn).
     2. A pen circles one word.
     3. The circle fills with blue and opens until it is the screen. */
  :global(html.motion) .prod {
    --ts: clamp(3rem, 12vw, 6rem);
    --flip: clamp(0, calc(var(--p, 0) / 0.26), 1);
    --draw: clamp(0, calc((var(--p, 0) - 0.3) / 0.16), 1);
    --g: clamp(0, calc((var(--p, 0) - 0.5) / 0.36), 1);
    --g2: calc(var(--g) * var(--g));
    /* how far the pen circle has opened (1 = the size it was drawn at) */
    --open: calc(1 + var(--g2) * 24);
  }

  :global(html.motion) .prod .stage {
    padding: 0;
  }

  :global(html.motion) .prod__dim {
    display: block;
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: rgb(60 45 10 / calc(0.22 * (1 - var(--flip))));
  }

  :global(html.motion) .prod__center {
    position: absolute;
    inset: var(--header-h) 0 0 0;
    width: auto;
    grid-template-rows: 1fr auto 1fr;
    justify-items: center;
    gap: clamp(1.5rem, 5svh, 3rem);
    padding-inline: var(--gutter);
    text-align: center;
    pointer-events: none;
  }

  :global(html.motion) .prod__title {
    grid-row: 2;
    font-size: var(--ts);
    color: color-mix(in srgb, var(--ink), var(--c-paper) calc(clamp(0, calc(var(--g) * 14), 1) * 100%));
  }

  /* The drawn circle sits behind the word. Its box never grows; the stroke
     inside it does, so the wobbling pen line stays the edge of the blue. */
  :global(html.motion) .prod__circle {
    display: block;
    position: absolute;
    z-index: -1;
    inset: -42% auto auto -16%;
    width: 132%;
    max-width: none;
    height: 180%;
    background: none;
    overflow: visible;
  }

  :global(html.motion) .prod__ring {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transform: scale(var(--open));
  }

  :global(html.motion) .prod__fill {
    fill: var(--c-blue);
    opacity: clamp(0, calc(var(--g) * 14), 1);
    pointer-events: fill;
  }

  :global(html.motion) .prod__pen {
    vector-effect: none;
    stroke: var(--blue);
    /* the line keeps its weight while the circle opens */
    stroke-width: calc(3px / var(--open));
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--draw));
  }

  /* Written on the blue once the circle has opened */
  :global(html.motion) .prod__lead {
    grid-row: 3;
    align-self: start;
    color: var(--c-paper);
    clip-path: inset(-10% calc((1 - clamp(0, calc((var(--g) - 0.78) / 0.22), 1)) * 104%) -10% -2%);
  }

  :global(html.motion) .prod__sheet {
    display: grid;
    place-items: end;
    position: absolute;
    inset: 0;
    padding: 0 var(--gutter) 9svh;
    transform-origin: 50% 0;
    transform: translate3d(0, calc(var(--flip) * -116%), 0) rotate(calc(var(--flip) * -4deg));
    box-shadow: var(--shadow-page);
    will-change: transform;
  }

  .prod__turn {
    display: flex;
    align-items: end;
    gap: 0.4rem;
    color: var(--c-blue);
  }
</style>
