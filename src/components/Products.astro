---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import StackLine from './StackLine.astro';
import { sketchEllipse } from '@/lib/sketch';
import type { Dictionary } from '@/i18n';
import apartarShot from '@/assets/products/apartar.png';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const p = t.products;
const f = p.featured;
const circle = sketchEllipse(200, 80, 182, 62, 'products-circle', 1);
const shownUrl = new URL(f.link).host;
---

<section id="products" class="prod" data-page="4" data-topic={t.header.topics.products}>
  <div class="prod__inner wrap">
    <header class="prod__head">
      <h2 class="display h2">
        <span class="prod__word" data-ink>
          <svg class="prod__circle" viewBox="0 0 400 160" preserveAspectRatio="none" aria-hidden="true">
            <path class="ink ink-draw" pathLength="1" d={circle}></path>
          </svg>
          {p.title}
        </span>
      </h2>
      <p class="lead soft">{p.lead}</p>
    </header>

    <article class="prod__item" aria-labelledby="prod-name">
      <div class="prod__text">
        <p class="prod__meta">
          <span class="mono prod__mark" aria-hidden="true">&lt;/&gt;</span>
          <span class="prod__name" id="prod-name">{f.name}</span>
          <span class="prod__kind">{f.kind}</span>
          <span class="prod__live">{f.status}</span>
        </p>
        <h3 class="display h3">{f.tagline}</h3>
        <p class="prod__body">{f.body}</p>
        <ul class="prod__points dash-list">
          {f.points.map((point) => <li>{point}</li>)}
        </ul>
        <StackLine label={t.projects.stack} stack={f.stack} />
        <a class="btn btn--primary prod__go" href={f.link} target="_blank" rel="noopener">
          {f.linkLabel}
          <Icon name="external" />
        </a>
      </div>

      <figure class="prod-shot">
        <span class="tape prod-shot__tape" aria-hidden="true"></span>
        <div class="prod-shot__bar" aria-hidden="true">
          <span class="prod-shot__dots"><i></i><i></i><i></i></span>
          <span class="prod-shot__url mono">{shownUrl}</span>
        </div>
        <Image
          class="prod-shot__img"
          src={apartarShot}
          alt={f.shotAlt}
          widths={[480, 720, 960, 1280, 1600]}
          sizes="(min-width: 60rem) min(46vw, 40rem), calc(100vw - 3rem)"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </article>
  </div>
</section>

<style>
  .prod {
    padding-top: var(--section-gap);
  }

  :global(html.motion) .prod {
    scroll-margin-top: 0;
  }

  .prod__inner {
    display: grid;
    gap: var(--block-gap);
  }

  .prod__head {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .prod__word {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  .prod__circle {
    position: absolute;
    z-index: -1;
    inset: -34% auto auto -12%;
    width: 124%;
    max-width: none;
    height: 168%;
    color: var(--blue);
    overflow: visible;
  }

  .prod__circle .ink {
    stroke-width: 3.5;
  }

  .prod__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3rem);
    align-items: center;
  }

  .prod__text {
    display: grid;
    gap: 1rem;
    justify-items: start;
    min-width: 0;
  }

  .prod__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    font-size: var(--text-small);
  }

  .prod__mark {
    color: var(--blue);
    font-weight: 700;
  }

  .prod__name {
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .prod__kind {
    color: var(--fg-soft);
  }

  .prod__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--good);
    font-weight: 700;
  }

  .prod__live::before {
    content: '';
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: currentColor;
  }

  .prod__body {
    max-width: 46ch;
    text-wrap: pretty;
  }

  .prod__points {
    display: grid;
    gap: 0.5rem;
    max-width: 46ch;
  }

  .prod__go {
    margin-top: 0.5rem;
  }

  .prod-shot {
    position: relative;
    margin: 0;
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--c-ink) 18%, transparent);
    border-radius: var(--radius-sheet);
    background: #f4f5f2;
    box-shadow: var(--shadow-sheet);
    rotate: 1.2deg;
  }

  .prod-shot__tape {
    top: -0.8rem;
    right: 1.5rem;
    rotate: 4deg;
    z-index: 1;
  }

  .prod-shot__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 12%, transparent);
    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
    background: #e9e6dd;
  }

  .prod-shot__dots {
    display: inline-flex;
    gap: 0.3rem;
  }

  .prod-shot__dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-ink) 22%, transparent);
  }

  .prod-shot__url {
    flex: 1;
    padding: 0.15rem 0.6rem;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.7);
    color: #5b5f6c;
    font-size: 0.8rem;
  }

  .prod-shot__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0 0 var(--radius-sheet) var(--radius-sheet);
  }

  :global([data-theme='dark']) .prod-shot {
    filter: brightness(0.9);
  }

  @media (min-width: 60rem) {
    .prod__item {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }
</style>
