---
import ContactPostcard from './contact/ContactPostcard.astro';
import SentNote from './contact/SentNote.astro';
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const c = t.contact;
---

<section id="contact" class="cont" data-page="5" data-topic={t.header.topics.contact}>
  <div class="cont__inner wrap">
    <header class="cont__head" data-ink>
      <h2 class="display h2">
        {c.pre}<mark class="cont__mark">{c.mark}</mark>{c.post}
      </h2>
      <p class="lead soft">{c.intro}</p>
    </header>

    <div class="cont-form" id="contact-form">
      <ContactPostcard t={t} />
      <SentNote title={c.successTitle} body={c.successBody} again={c.again} />
    </div>
  </div>
</section>

<style>
  .cont {
    padding-block: var(--section-gap);
  }

  :global(html.motion) .cont {
    scroll-margin-top: 0;
  }

  .cont__inner {
    display: grid;
    gap: var(--block-gap);
  }

  .cont__head {
    display: grid;
    gap: 0.75rem;
  }

  .cont__mark {
    white-space: nowrap;
  }

  :global(html.motion) [data-ink] .cont__mark {
    color: inherit;
    background-size: 0% var(--mark-size);
    transition:
      background-size 0.5s var(--ease-ink) 0.2s,
      color 0.2s linear 0.35s;
  }

  :global(html.motion) [data-ink].is-in .cont__mark {
    color: var(--mark-fg);
    background-size: 100% var(--mark-size);
  }

  .cont-form {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
</style>
