# Contact form backend. The inbox address lives in the form service, so no
# email or phone number is ever published on the site.
#
# Formspree:  create a form at https://formspree.io and paste its endpoint
#   PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# Web3Forms:  use its submit URL and your public access key
#   PUBLIC_CONTACT_ENDPOINT=https://api.web3forms.com/submit
#   PUBLIC_CONTACT_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_CONTACT_ACCESS_KEY=
